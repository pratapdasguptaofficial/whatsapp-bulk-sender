{
  "name": "whatsapp-bulk-sender",
  "version": "1.1.0",
  "author": "PSP Softech",
  "description": "WhatsApp Bulk Sender",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder"
  },
  "build": {
    "asar": false,
    "appId": "com.pspsoftech.wabulksender",
    "productName": "WA Bulk Sender",
    "copyright": "Copyright © 2026 PSP Softech",
    "publish": null,
    "files": [
      "**/*",
      "!node_modules/.cache"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/logo.ico",
      "legalTrademarks": "PSP Softech"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/logo.ico",
      "uninstallerIcon": "assets/logo.ico"
    }
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "axios": "^1.20.0",
    "baileys": "^7.0.0-rc14",
    "fs-extra": "^11.4.0",
    "node-machine-id": "^1.1.12",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^41.2.1",
    "electron-builder": "^26.0.12",
    "electron-reload": "^1.5.0"
  }
}
